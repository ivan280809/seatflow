{
  "name": "seatflow",
  "version": "0.0.0",
  "private": true,
  "description": "Event-driven seat reservation platform for learning Node.js and distributed systems.",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/reservation-api",
    "apps/payment-worker",
    "apps/notification-worker",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "node --test",
    "build": "tsc --build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
