{
  "name": "seatflow",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "description": "Event-driven seat reservation platform for learning Node.js and distributed systems.",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "jest",
    "build": "tsc --build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.0",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "jest": "30.4.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
